<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Embedded symbols keep the single-file publish to exactly one file. -->
    <DebugType>embedded</DebugType>
    <!-- Lets the Windows Desktop targeting pack restore on non-Windows build hosts. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Product>Remote Commander Tray</Product>
    <Company>Remote Commander Tray contributors</Company>
    <Copyright>Copyright (c) 2026 Peter Shanxin</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
